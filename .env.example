# Copy to .env.local for development. On Vercel, add each one under Settings → Environment Variables.

# MongoDB connection string (MongoDB Atlas works well with Vercel).
# Without it the public site still runs on its built-in catalog, but requests aren't stored
# and the dashboard can't load.
MONGODB_URI='mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/setabase'

# Signs the admin session cookie. At least 32 characters; `npm run admin:hash` prints a fresh one.
AUTH_SECRET='replace-with-a-long-random-string-of-at-least-32-characters'

# The one admin account. Make the hash with: npm run admin:hash -- "your password"
# and paste the ADMIN_PASSWORD_HASH line it prints. In this file every $ of the hash is
# written as \$ — Next.js expands $VAR inside .env files and would otherwise eat the hash.
# (On Vercel, paste the plain hash; the script prints that form too.)
ADMIN_EMAIL='admin@setabase.com'
ADMIN_PASSWORD_HASH='\$2b\$12\$replace-with-the-line-printed-by-the-script'

# Public URL of the site, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL='https://setabase.com'
